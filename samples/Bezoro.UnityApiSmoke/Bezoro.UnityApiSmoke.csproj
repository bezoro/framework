<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- The framework stays on latest. This consumer deliberately checks Unity's source language level. -->
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(FrameworkBinaryRoot)' == ''">
    <ProjectReference Include="../../src/Bezoro.Core/Bezoro.Core.csproj" />
    <ProjectReference Include="../../src/Bezoro.Simulation/Bezoro.Simulation.csproj" />
    <ProjectReference Include="../../src/Bezoro.Navigation/Bezoro.Navigation.csproj" />
    <ProjectReference Include="../../src/Bezoro.Persistence/Bezoro.Persistence.csproj" />
    <ProjectReference Include="../../src/Bezoro.Inventory/Bezoro.Inventory.csproj" />
    <ProjectReference Include="../../src/Bezoro.StateMachines/Bezoro.StateMachines.csproj" />
    <ProjectReference Include="../../src/Bezoro.Spatial/Bezoro.Spatial.csproj" />
    <ProjectReference Include="../../src/Bezoro.Conditions/Bezoro.Conditions.csproj" />
    <ProjectReference Include="../../src/Bezoro.Statecharts/Bezoro.Statecharts.csproj" />
    <ProjectReference Include="../../src/Bezoro.BehaviorTrees/Bezoro.BehaviorTrees.csproj" />
    <ProjectReference Include="../../src/Bezoro.Behaviors/Bezoro.Behaviors.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrameworkBinaryRoot)' != ''">
    <Reference Include="Bezoro.Core"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Core.dll</HintPath></Reference>
    <Reference Include="Bezoro.Simulation"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Simulation.dll</HintPath></Reference>
    <Reference Include="Bezoro.Navigation"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Navigation.dll</HintPath></Reference>
    <Reference Include="Bezoro.Persistence"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Persistence.dll</HintPath></Reference>
    <Reference Include="Bezoro.Inventory"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Inventory.dll</HintPath></Reference>
    <Reference Include="Bezoro.StateMachines"><HintPath>$(FrameworkBinaryRoot)/Bezoro.StateMachines.dll</HintPath></Reference>
    <Reference Include="Bezoro.Spatial"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Spatial.dll</HintPath></Reference>
    <Reference Include="Bezoro.Conditions"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Conditions.dll</HintPath></Reference>
    <Reference Include="Bezoro.Statecharts"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Statecharts.dll</HintPath></Reference>
    <Reference Include="Bezoro.BehaviorTrees"><HintPath>$(FrameworkBinaryRoot)/Bezoro.BehaviorTrees.dll</HintPath></Reference>
    <Reference Include="Bezoro.Behaviors"><HintPath>$(FrameworkBinaryRoot)/Bezoro.Behaviors.dll</HintPath></Reference>
  </ItemGroup>
</Project>
